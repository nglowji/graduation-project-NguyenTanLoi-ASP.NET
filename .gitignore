# -----------------------------------------------------------------------------
# SmartSport repository ignore rules
# Keep source, migrations, docs, CI/CD config, and production-safe config tracked.
# Ignore local machines, secrets, dependency folders, build outputs, logs, caches.
# -----------------------------------------------------------------------------

# Editors / IDEs
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Environment and secrets
.env
.env.*
!.env.example
!client/.env.production
*.local
*.secret
*.key
*.pem
appsettings.Local.json
appsettings.*.Local.json

# Logs and diagnostics
*.log
logs/
LogFiles/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / React / Vite
node_modules/
dist/
build/
.vite/
.vercel/
.netlify/
coverage/
*.tsbuildinfo

# .NET build output
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/
*.nupkg
*.snupkg
*.lscache
project.lock.json
project.fragment.lock.json

# Test output
[Tt]est[Rr]esult*/
TestResults/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml

# Local databases / generated runtime files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.tmp
*.temp

# Generated documents and large local exports
*.doc
*.docx
*.pdf
*.zip
*.rar
*.7z

# AI agent / scratch workspace
.agents/
.gemini/
brain/
scratch/
implementation_plan.md
task.md
walkthrough.md
